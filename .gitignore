# Python environments and caches
.venv/
.venv-linux/
__pycache__/

# Large raw scanner exports
*.dcm

# OS clutter
.DS_Store

# Generated by vessel_ml/ and reproducible from the videos + vessel_ml/prompts.json:
# cropped frames, classical-tracker masks, overlays, predictions, review videos.
# The SAM masks are kept in git: regenerating them takes ~35 min of GPU time.
data/vessel_dataset/*
!data/vessel_dataset/masks/

# SAM 2 weights (176 MB download) and logs are ignored; trained U-Nets are kept
vessel_ml/checkpoints/*
!vessel_ml/checkpoints/unet_*.pt

# Downloaded archives (contents are extracted under data/)
*.zip

# Local working notes, kept untracked on purpose
Memories.md
